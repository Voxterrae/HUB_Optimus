{
  "name": "hub-optimus-operator-infra",
  "version": "0.1.0",
  "author": "Lars Andersson",
  "bin": {
    "hub-optimus-operator-infra": "bin/hub-optimus-operator-infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "check": "npm run verify:lambda-build && npm run build && npm test -- --runInBand",
    "cdk": "cdk",
    "predeploy:check": "node --require ts-node/register scripts/predeploy-check.ts",
    "verify:lambda-build": "node --require ts-node/register scripts/verify-lambda-build.ts"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "ts-jest": "^29",
    "aws-cdk": "2.1135.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.0.0"
  }
}
