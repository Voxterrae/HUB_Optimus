{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROPOSED synthetic T5 decoded corpus; no enrollment or authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "baseline", "cases"],
  "properties": {
    "version": {"const": "relay.t5-resolution-corpus.v0.1"},
    "status": {"const": "PROPOSED_SYNTHETIC_ONLY"},
    "baseline": {"$ref": "#/$defs/scenario"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "hex32": {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}(?![\\s\\S])"},
    "hex64": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "sec1": {"type": "string", "minLength": 130, "maxLength": 130, "pattern": "^04[0-9a-f]{128}(?![\\s\\S])"},
    "epoch": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hex32"}]},
    "tick": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "namespace": {"enum": ["fictional:personal", "fictional:company"]},
    "account": {"enum": ["fictional:account-a", "fictional:account-b"]},
    "authorizer": {"enum": ["fictional:authorizer-a", "fictional:authorizer-b"]},
    "policyRef": {"enum": ["fictional:policy-a", "fictional:policy-b"]},
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["local", "pending", "snapshot", "presented"],
      "properties": {
        "local": {"$ref": "#/$defs/local"}, "pending": {"$ref": "#/$defs/pending"},
        "snapshot": {"$ref": "#/$defs/snapshot"}, "presented": {"$ref": "#/$defs/presented"}
      }
    },
    "local": {
      "type": "object", "additionalProperties": false,
      "required": ["namespaceRef", "accountRef", "authorizerRef", "targetId", "profileId", "brokerStartGeneration", "policyRef", "policyDigest", "nowTick"],
      "properties": {
        "namespaceRef": {"$ref": "#/$defs/namespace"}, "accountRef": {"$ref": "#/$defs/account"},
        "authorizerRef": {"$ref": "#/$defs/authorizer"}, "targetId": {"$ref": "#/$defs/hex32"},
        "profileId": {"$ref": "#/$defs/hex32"}, "brokerStartGeneration": {"$ref": "#/$defs/hex32"},
        "policyRef": {"$ref": "#/$defs/policyRef"}, "policyDigest": {"$ref": "#/$defs/hex64"},
        "nowTick": {"$ref": "#/$defs/tick"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "requestId", "operation", "brokerKeyId", "targetId", "profileId", "enrollmentGeneration", "brokerStartGeneration", "nonce", "fields", "ttlMs"],
      "properties": {
        "version": {"const": "relay.native-request.v0.1"}, "operation": {"const": "windows.runtime_inventory.v0_1"},
        "requestId": {"$ref": "#/$defs/hex32"}, "brokerKeyId": {"$ref": "#/$defs/hex64"},
        "targetId": {"$ref": "#/$defs/hex32"}, "profileId": {"$ref": "#/$defs/hex32"},
        "enrollmentGeneration": {"$ref": "#/$defs/hex32"}, "brokerStartGeneration": {"$ref": "#/$defs/hex32"},
        "nonce": {"$ref": "#/$defs/hex64"}, "fields": {"const": ["windows", "powershell7", "node"]},
        "ttlMs": {"const": 60000}
      }
    },
    "pending": {
      "type": "object", "additionalProperties": false, "required": ["request", "requestDigest"],
      "properties": {"request": {"$ref": "#/$defs/request"}, "requestDigest": {"$ref": "#/$defs/hex64"}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyRef", "policyDigest", "validFromTick", "validUntilTick"],
      "properties": {
        "policyRef": {"$ref": "#/$defs/policyRef"}, "policyDigest": {"$ref": "#/$defs/hex64"},
        "validFromTick": {"$ref": "#/$defs/tick"}, "validUntilTick": {"$ref": "#/$defs/tick"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["storeState", "epochBefore", "epochSnapshot", "epochAfter", "policy", "records"],
      "properties": {
        "storeState": {"enum": ["available", "missing", "inaccessible", "corrupt"]},
        "epochBefore": {"$ref": "#/$defs/epoch"}, "epochSnapshot": {"$ref": "#/$defs/epoch"},
        "epochAfter": {"$ref": "#/$defs/epoch"},
        "policy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/policy"}]},
        "records": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/record"}}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["namespaceRef", "accountRef", "authorizerRef", "targetId", "profileId", "enrollmentGeneration", "brokerKeyId", "brokerSec1Hex", "approverSec1Hex", "transportSpkiPin", "policyRef", "lifecycle"],
      "properties": {
        "namespaceRef": {"$ref": "#/$defs/namespace"}, "accountRef": {"$ref": "#/$defs/account"},
        "authorizerRef": {"$ref": "#/$defs/authorizer"}, "targetId": {"$ref": "#/$defs/hex32"},
        "profileId": {"$ref": "#/$defs/hex32"}, "enrollmentGeneration": {"$ref": "#/$defs/hex32"},
        "brokerKeyId": {"$ref": "#/$defs/hex64"}, "brokerSec1Hex": {"$ref": "#/$defs/sec1"},
        "approverSec1Hex": {"$ref": "#/$defs/sec1"}, "transportSpkiPin": {"$ref": "#/$defs/hex64"},
        "policyRef": {"$ref": "#/$defs/policyRef"}, "lifecycle": {"enum": ["active", "revoked"]}
      }
    },
    "presented": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "brokerSec1Hex", "approverSec1Hex", "transportSec1Hex"],
      "properties": {
        "request": {"$ref": "#/$defs/request"}, "brokerSec1Hex": {"$ref": "#/$defs/sec1"},
        "approverSec1Hex": {"$ref": "#/$defs/sec1"}, "transportSec1Hex": {"$ref": "#/$defs/sec1"}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["status", "code", "operationalAuthority"],
      "properties": {
        "status": {"enum": ["candidate-consistent", "denied"]}, "operationalAuthority": {"const": "absent"},
        "code": {"enum": [null, "StoreUnavailable", "StoreChanged", "PolicyUnavailable", "PolicyMismatch", "NoRecord", "AmbiguousRecord", "BindingMismatch", "Revoked", "GenerationMismatch", "KeyMismatch", "RoleMismatch", "PendingMismatch"]}
      },
      "oneOf": [
        {"properties": {"status": {"const": "candidate-consistent"}, "code": {"type": "null"}}},
        {"properties": {"status": {"const": "denied"}, "code": {"type": "string"}}}
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["id", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
        "expected": {"$ref": "#/$defs/outcome"}
      }
    }
  }
}
