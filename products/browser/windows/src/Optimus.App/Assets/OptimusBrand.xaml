<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original Optimus geometry. Regenerate with tools/brand/generate_assets.py. -->
    <SolidColorBrush x:Key="OptimusAccentBrush" Color="#54E0C1" />
    <SolidColorBrush x:Key="OptimusSurfaceBrush" Color="#14232E" />
    <SolidColorBrush x:Key="OptimusTextBrush" Color="#F2FAF8" />
    <DrawingImage x:Key="OptimusLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource OptimusSurfaceBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="56" RadiusY="56" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource OptimusAccentBrush}" Geometry="M 88,40 L 148,40 L 112,76 L 104,76 L 76,104 L 76,152 L 104,180 L 152,180 L 180,152 L 180,112 L 216,76 L 216,168 L 168,216 L 88,216 L 40,168 L 40,88 Z" />
                <GeometryDrawing Brush="{StaticResource OptimusTextBrush}" Geometry="M 168,40 L 216,40 L 216,88 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
