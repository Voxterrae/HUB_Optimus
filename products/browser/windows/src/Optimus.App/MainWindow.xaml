<Window x:Class="Optimus.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Optimus.Core;assembly=Optimus.Core" Title="Optimus · 0.3.1 alpha" Icon="Assets/optimus.ico" Width="1400" Height="920" MinWidth="420" MinHeight="420" FontSize="{DynamicResource OptimusBodySize}" Background="{DynamicResource OptimusPageBrush}" Foreground="{DynamicResource OptimusTextBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource OptimusPanelBrush}" BorderBrush="{DynamicResource OptimusBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Margin="5,0,16,0" VerticalAlignment="Center"><Image Source="{StaticResource OptimusLogo}" Width="32" Height="32"/><TextBlock x:Name="BrandWord" Text="optimus." FontWeight="SemiBold" FontSize="24" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="←" Click="Back_Click" AutomationProperties.Name="Atrás" ToolTip="Atrás · Alt+Izquierda" Padding="10,6" Style="{StaticResource OptimusQuietButton}"/>
      <Button x:Name="ForwardButton" Content="→" Click="Forward_Click" AutomationProperties.Name="Adelante" ToolTip="Adelante · Alt+Derecha" Padding="10,6" Style="{StaticResource OptimusQuietButton}"/>
      <Button x:Name="ReloadButton" Content="↻" Click="Reload_Click" AutomationProperties.Name="Recargar" ToolTip="Recargar · F5" Padding="10,6" Style="{StaticResource OptimusQuietButton}"/>
      <Button x:Name="HomeButton" Content="⌂" Click="Home_Click" AutomationProperties.Name="Inicio" ToolTip="Inicio · Alt+Inicio" Padding="10,6" Style="{StaticResource OptimusQuietButton}"/>
     </StackPanel>
     <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="Address" FlowDirection="LeftToRight" AutomationProperties.Name="Dirección o búsqueda" ToolTip="Escribe una dirección o busca con Optimus · Ctrl+L" KeyDown="Address_KeyDown" VerticalContentAlignment="Center" MinWidth="70"/>
      <Button Grid.Column="1" Content="→" Click="Go_Click" AutomationProperties.Name="Ir a la dirección o buscar" ToolTip="Ir o buscar · Intro" Style="{StaticResource OptimusPrimaryButton}" Padding="12,6"/>
     </Grid>
     <StackPanel Grid.Column="3" Orientation="Horizontal">
      <Button x:Name="PrivateButton" Content="◈" Click="NewPrivate_Click" AutomationProperties.Name="Nueva pestaña privada" ToolTip="Nueva pestaña privada · Ctrl+Mayús+N" Padding="10,6" Style="{StaticResource OptimusQuietButton}"/>
      <Button x:Name="MenuButton" Content="☰" Click="Menu_Click" AutomationProperties.Name="Menú de Optimus" ToolTip="Menú · pestañas, ayuda y ajustes" Padding="10,6" Style="{StaticResource OptimusQuietButton}">
       <Button.ContextMenu><ContextMenu>
        <MenuItem Header="Nueva pestaña" Click="NewTab_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="Nueva pestaña privada" Click="NewPrivate_Click" InputGestureText="Ctrl+Mayús+N"/>
        <MenuItem Header="Cerrar pestaña" Click="CloseTab_Click" InputGestureText="Ctrl+W"/>
        <MenuItem Header="Recuperar pestaña" Click="RecoverTab_Click"/>
        <Separator/>
        <MenuItem Header="Inicio" Click="Home_Click" InputGestureText="Alt+Inicio"/>
        <MenuItem Header="Adelante" Click="Forward_Click" InputGestureText="Alt+Derecha"/>
        <MenuItem Header="Recargar" Click="Reload_Click" InputGestureText="F5"/>
        <MenuItem Header="Guardados" Click="Bookmarks_Click"/>
        <MenuItem Header="Descargas" Click="Downloads_Click"/>
        <MenuItem Header="Ayuda paso a paso" Click="Help_Click" InputGestureText="F1"/>
        <MenuItem Header="Ajustes" Click="Settings_Click"/>
       </ContextMenu></Button.ContextMenu>
      </Button>
     </StackPanel>
    </Grid>
    <WrapPanel Margin="8,2,8,0" VerticalAlignment="Center"><TextBlock x:Name="ModeLabel" Text="Normal" TextWrapping="Wrap" FontSize="{DynamicResource OptimusSmallSize}" Foreground="{DynamicResource OptimusMutedBrush}" Margin="0,4,16,2"/><Button x:Name="OpenPendingPrivate" Click="OpenPendingPrivate_Click" Visibility="Collapsed" Style="{StaticResource OptimusPrimaryButton}" MaxWidth="320"><TextBlock Text="Abrir destino en privado" TextWrapping="Wrap" Foreground="{DynamicResource OptimusOnAccentBrush}"/></Button></WrapPanel>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Background="{DynamicResource OptimusPanelBrush}" BorderBrush="{DynamicResource OptimusBorderBrush}" BorderThickness="0,0,1,0" Padding="12,24,12,12">
    <DockPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="⚙  Ajustes" Click="Settings_Click" Style="{StaticResource OptimusNavButton}"/><TextBlock Text="BY HUB_OPTIMUS" Foreground="{DynamicResource OptimusMutedBrush}" FontSize="{DynamicResource OptimusSmallSize}" Margin="10,18,0,4"/></StackPanel><StackPanel><TextBlock Text="TU ESPACIO" FontSize="{DynamicResource OptimusSmallSize}" Foreground="{DynamicResource OptimusMutedBrush}" Margin="12,0,0,16"/><Button Content="⌂  Inicio" Click="Home_Click" Style="{StaticResource OptimusNavButton}"/><Button Content="◇  Guardados" Click="Bookmarks_Click" Style="{StaticResource OptimusNavButton}"/><Button Content="✧  Ayuda" Click="Help_Click" Style="{StaticResource OptimusNavButton}"/><Button Content="＋  Pestaña" Click="NewTab_Click" Style="{StaticResource OptimusNavButton}"/></StackPanel></DockPanel>
   </Border>
   <Grid Grid.Column="1" x:Name="ContentRegion"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HelpColumn" Width="0"/></Grid.ColumnDefinitions>
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_Changed" AutomationProperties.Name="Pestañas"/>
    <Border x:Name="HelpPanel" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource OptimusBorderBrush}" Background="{DynamicResource OptimusPanelBrush}" Padding="20" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Un poco de ayuda." FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Click="HideHelp_Click" AutomationProperties.Name="Cerrar ayuda" Style="{StaticResource OptimusQuietButton}"/></Grid>
      <TextBlock Text="Paso a paso, sin palabras complicadas." Foreground="{DynamicResource OptimusWarmBrush}" TextWrapping="Wrap" Margin="0,4,0,20"/>
      <TextBlock Text="Guía local · sin IA remota conectada" Foreground="{DynamicResource OptimusMutedBrush}" FontSize="{DynamicResource OptimusSmallSize}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBox x:Name="Question" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" AutomationProperties.Name="Pregunta a la guía local"/>
      <Button Content="Consultar guía" Click="Ask_Click" Style="{StaticResource OptimusPrimaryButton}" Margin="3,8,3,16"/>
      <TextBox x:Name="GuideAnswer" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" MinHeight="72" AutomationProperties.Name="Respuesta de la guía local"/>
      <TextBlock x:Name="ProposalText" TextWrapping="Wrap" Margin="0,8"/>
      <WrapPanel><Button x:Name="ConfirmProposal" Content="Confirmar acción" Click="Confirm_Click" IsEnabled="False"/><Button Content="Cancelar acción" Click="Cancel_Click"/></WrapPanel>
      <Expander Header="Revisar un fragmento"><StackPanel>
       <TextBlock Text="Vista previa local. No se envía a nadie." Foreground="{DynamicResource OptimusMutedBrush}" TextWrapping="Wrap" Margin="0,8"/>
       <Button Content="Revisar selección de esta página" Click="PreviewSelection_Click"/>
       <Button Content="Revisar texto pegado" Click="PreviewPaste_Click"/>
       <TextBox x:Name="ShareText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" AutomationProperties.Name="Texto de la vista previa, editable, revisión limitada a 8000 caracteres" TextChanged="ShareText_Changed"/>
       <TextBlock x:Name="ShareAttribution" TextWrapping="Wrap" Text="Destinatario: ninguno; envío desactivado." FontSize="{DynamicResource OptimusSmallSize}" Margin="0,10"/>
       <Button Content="Enviar fragmento · no disponible" IsEnabled="False"/>
       <Button Content="Cancelar vista previa" Click="CancelShare_Click"/>
      </StackPanel></Expander>
     </StackPanel></ScrollViewer>
    </Border>
    <Border x:Name="SettingsPanel" Grid.ColumnSpan="2" Background="{DynamicResource OptimusPageBrush}" Padding="24" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="A tu manera." FontSize="{DynamicResource OptimusTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/><Button Grid.Column="1" Content="×" Click="CloseSettings_Click" AutomationProperties.Name="Cerrar ajustes" Style="{StaticResource OptimusQuietButton}"/></Grid>
      <TextBlock Text="Haz que Optimus se adapte a ti." Foreground="{DynamicResource OptimusMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,24"/>
      <TextBlock Text="Lectura y apariencia" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Tamaño del texto y zoom de las páginas" TextWrapping="Wrap"/>
      <ComboBox x:Name="ScaleChoice" AutomationProperties.Name="Tamaño y zoom" SelectionChanged="Scale_Changed" MaxWidth="280" HorizontalAlignment="Left" MinWidth="120"><ComboBoxItem Content="100 %"/><ComboBoxItem Content="125 %"/><ComboBoxItem Content="150 %"/><ComboBoxItem Content="200 %"/></ComboBox>
      <CheckBox x:Name="ContrastChoice" Content="Contraste alto" Click="Appearance_Click"/>
      <TextBlock Text="Búsqueda" FontWeight="SemiBold" Margin="0,24,0,12"/>
      <TextBlock Text="Al escribir una búsqueda en la barra de dirección" TextWrapping="Wrap"/>
      <ComboBox x:Name="SearchChoice" AutomationProperties.Name="Proveedor de búsqueda" SelectionChanged="Search_Changed" SelectedValuePath="Tag"><ComboBoxItem Content="Optimus Search" Tag="{x:Static core:SearchProvider.Optimus}"/><ComboBoxItem Content="DuckDuckGo" Tag="{x:Static core:SearchProvider.DuckDuckGo}"/><ComboBoxItem Content="Google" Tag="{x:Static core:SearchProvider.Google}"/></ComboBox>
      <TextBlock Text="Optimus Search permite elegir Web, Índice y Wikipedia dentro de su buscador. Web necesita un proveedor configurado." TextWrapping="Wrap" Foreground="{DynamicResource OptimusMutedBrush}" FontSize="{DynamicResource OptimusSmallSize}" Margin="3,8,0,12"/>
      <Button Content="Configurar privacidad y buscador" Click="PrivacySettings_Click" HorizontalAlignment="Left"/>
      <TextBlock Text="Privacidad y sesión" FontWeight="SemiBold" Margin="0,24,0,12"/>
      <CheckBox x:Name="RestoreChoice" Click="Restore_Click"><TextBlock Text="Restaurar direcciones al abrir Optimus" TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="Esta opción guarda direcciones de pestañas normales. Las privadas no se restauran." Foreground="{DynamicResource OptimusMutedBrush}" TextWrapping="Wrap" FontSize="{DynamicResource OptimusSmallSize}" Margin="3,4,0,12"/>
      <WrapPanel><Button Content="Abrir sitio actual en privado" Click="CurrentPrivate_Click"/><Button Content="Descargas" Click="Downloads_Click"/><Button Content="Revocar permisos" Click="RevokePermissions_Click"/><Button Content="Borrar datos de sitios" Click="ClearData_Click"/></WrapPanel>
      <TextBlock Text="Optimus 0.3.1 alpha · Sin firma. Privado limita el guardado local; no ofrece anonimato." TextWrapping="Wrap" FontSize="{DynamicResource OptimusSmallSize}" Foreground="{DynamicResource OptimusMutedBrush}" Margin="0,28,0,12"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource OptimusBorderBrush}" Background="{DynamicResource OptimusPanelBrush}" Padding="12,7"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Status" Text="Optimus 0.3.1 alpha · Listo para empezar." TextWrapping="Wrap" FontSize="{DynamicResource OptimusSmallSize}" Foreground="{DynamicResource OptimusMutedBrush}" AutomationProperties.LiveSetting="Polite"/></ScrollViewer></Border>
 </Grid>
</Window>
