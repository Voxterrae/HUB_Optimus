<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OptimusProductRoot)/products/browser/windows/src/Optimus.Core/Optimus.Core.csproj" />
  </ItemGroup>
  <Target Name="RequireExplicitProductRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(OptimusProductRoot)' == ''" Text="An explicit absolute OptimusProductRoot is required; the harness never substitutes its own product sources." />
    <Error Condition="'$(OptimusProductRoot)' != '' And !$([System.IO.Path]::IsPathFullyQualified('$(OptimusProductRoot)'))" Text="OptimusProductRoot must be absolute." />
    <Error Condition="!Exists('$(OptimusProductRoot)/products/browser/windows/src/Optimus.Core/Optimus.Core.csproj')" Text="The pinned product Core project is missing." />
  </Target>
</Project>
