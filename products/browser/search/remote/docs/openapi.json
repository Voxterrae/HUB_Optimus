  "components": {
    "securitySchemes": {
      "remoteBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque 32-byte CSPRNG secret encoded canonical base64url without padding"
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "limit"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Nonblank; <=500 UTF-16 units (server validation), no control characters or invalid Unicode."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      },
      "Provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceKind",
          "referenceCheckedDate",
          "sourceRevision",
          "summarySha256"
        ],
        "properties": {
          "referenceKind": {
            "type": "string",
            "enum": [
              "github-immutable",
              "microsoft-live"
            ]
          },
          "referenceCheckedDate": {
            "type": "string",
            "format": "date"
          },
          "sourceRevision": {
            "type": [
              "string",
              "null"
            ]
          },
          "summarySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "content",
          "source",
          "updatedUtc",
          "provenance"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "content": {
            "type": "string",
            "description": "Full Optimus-authored summary; hash covers these UTF-8 bytes."
          },
          "source": {
            "type": "string"
          },
          "updatedUtc": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "catalogId",
          "catalogSha256",
          "provenanceSha256",
          "results"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "catalogId": {
            "type": "string",
            "const": "optimus-public-pilot-v0.1"
          },
          "catalogSha256": {
            "type": "string",
            "const": "8294911789f69f2c1262c80153ca0dddd6189e9a198b586f5fbb3beeb0d665ec"
          },
          "provenanceSha256": {
            "type": "string",
            "const": "5312f482daea11727c9c90a683bcf95dce587021aa6c63609b9038756eb05aae"
          },
          "results": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "catalogId",
          "catalogSha256",
          "provenanceSha256",
          "catalogBytesBase64",
          "provenanceBytesBase64"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "catalogId": {
            "type": "string",
            "const": "optimus-public-pilot-v0.1"
          },
          "catalogSha256": {
            "type": "string",
            "const": "8294911789f69f2c1262c80153ca0dddd6189e9a198b586f5fbb3beeb0d665ec"
          },
          "provenanceSha256": {
            "type": "string",
            "const": "5312f482daea11727c9c90a683bcf95dce587021aa6c63609b9038756eb05aae"
          },
          "catalogBytesBase64": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "provenanceBytesBase64": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "error"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "method_not_allowed",
              "deadline_exceeded",
              "too_large",
              "unsupported_media_type",
              "rate_limited",
              "busy",
              "internal_error"
            ]
          }
        }
      }
    }
  }
