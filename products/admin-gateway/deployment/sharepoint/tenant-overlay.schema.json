{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huboptimus.example/schemas/admin-gateway-tenant-overlay.json",
  "title": "Optimus Admin Gateway tenant overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clientCode", "environment", "identity", "storage", "pilot"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "clientCode": {"type": "string", "pattern": "^[A-Z0-9_-]{2,32}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classification"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "classification": {"enum": ["DEV", "TEST", "PROD"]},
        "dataverseUrl": {"type": "string", "format": "uri"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerUpn", "approverUpns", "executorIdentityReference"],
      "properties": {
        "ownerUpn": {"type": "string", "format": "email"},
        "approverUpns": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "email"}},
        "executorIdentityReference": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharePointControlPath", "auditTablePrefix"],
      "properties": {
        "sharePointControlPath": {"type": "string", "minLength": 1},
        "auditTablePrefix": {"type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$"}
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetMailbox", "delegateMailbox", "allowedOperations"],
      "properties": {
        "targetMailbox": {"type": "string", "format": "email"},
        "delegateMailbox": {"type": "string", "format": "email"},
        "allowedOperations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(exchange|powershell)\\.[a-z0-9_]+$"}
        }
      }
    }
  }
}
